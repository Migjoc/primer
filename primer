if (typeof module !== 'undefined' && module.exports) {
    module.exports = {
        PROTOCOL_VERSION: PROTOCOL_VERSION,
        agentConfig: agentConfig,
        forgetToken: forgetToken,
        tokenComplaint: tokenComplaint,
        netReason: netReason,
        applyJob: applyJob,
        handle: handle,
        pickEdge: pickEdge,
        bazisHost: bazisHost,
        startAgent: startAgent
    };
}

// Внутри Базиса файл запускается как скрипт: глобаль Action есть только там.
