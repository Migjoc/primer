// Агент Базиса v2 — ЕДИНСТВЕННЫЙ файл, живущий внутри Базиса.
//
// Перезапуск агента — это ручные клики в Базисе, поэтому он написан так, чтобы
// меняться почти никогда: по проводу едут ДАННЫЕ (список команд), а не код.
// Вся изменчивость живёт в репозитории (src/bazis/emit.ts), агент остаётся
// интерпретатором. Исполнения произвольного JS у него НЕТ: единственный способ
// что-то изменить в модели — список команд, который агент умеет разобрать.
//
// Три правила хоста, нарушение которых стоит дорого:
//   1. Action.Commit() обязателен: без него созданные объекты не видны в Model
//      и не переживают вызов. Транзакцией владеет агент: одна задача = одна
//      транзакция, любая ошибка ? Action.Revert(), а не половина кухни в модели.
//   2. Двойное удаление роняет ПРОЦЕСС (try/catch не ловит — падает движок).
//      Model.forEach рекурсивен и заходит внутрь блоков, поэтому удаление ходит
//      ТОЛЬКО по верхнему уровню.
//   3. NewHoleDrilling() и MakeFromHoles() роняют Базис — DrillHoles(p1,p2)
//      зовётся напрямую.
//
// Файл — ES5 и без внешних зависимостей: он же грузится в тесты под vitest
// (tests/bazis/agent.test.ts) поверх фейкового хоста.

var PROTOCOL_VERSION = 8;

/* -- Крепёж: его ставит СХЕМА ЦЕХА, а не мы -----------------------------------
 *
 * Присадку нельзя собирать из отверстий руками: у самодельной нулевой габарит,
 * и при следующем открытии файла Базис перестраивает её по своему шаблону.
 * Строить её из позиции базы крепежа мы тоже перестали: сколько крепежа нужно
 * на стык и где именно -- правило ЦЕХА, а не наше, и записано оно схемой
 * в его же Базисе.
 *
 * Поэтому агент возит СХЕМУ (команды scheme + mountScheme): строку, которую
 * оператор захватил в диалоге выбора, и пару панелей. Дальше Базис считает
 * раскладку сам -- ровно так же, как когда её ставит человек. Схем не дали --
 * мебель приезжает без присадки, и ставит её оператор.
 * -------------------------------------------------------------------------- */

/* ?? Интерпретатор ?????????????????????????????????????????????????????????? */

function emptyStats() {
    return { panels: 0, schemes: 0, butts: 0, assemblies: 0, extrusions: 0, deleted: 0, commits: 0 };
}

/* -- Отчёт о времени сборки --------------------------------------------------
 *
 * Сборка идёт СИНХРОННО и держит поток, в котором Базис отзывается на мышь:
 * пока идут команды, окно не перерисовывается вовсе, и «завис» снаружи
 * неотличимо от «работает молча». Отличить их можно только следом в журнале,
 * поэтому он пишется ПО ХОДУ, а не в конце: `appendFileSync` дописывает файл
 * сразу, и след переживает даже снятие Базиса из диспетчера задач.
 *
 * Три вида записей и три разных вопроса:
 *   удар пульса (раз в APPLY_BEAT_MS) -- «где мы сейчас»: строка оборвалась
 *      на команде N -- значит завис именно N, а не сборка вообще;
 *   медленная команда (дольше APPLY_SLOW_MS) -- «кто именно долгий»;
 *   итог -- «куда ушло время»: по видам команд, худшая по времени и отдельной
 *      строкой Commit, который у Базиса сам по себе не бесплатен.
 * -------------------------------------------------------------------------- */

/** Как часто сборка отмечается в журнале: реже -- грубее место зависания. */
var APPLY_BEAT_MS = 2000;
/** Команда дольше этого называется поимённо: одна такая объясняет всё. */
var APPLY_SLOW_MS = 500;

function profiler(host) {
    var started = Date.now();
    var beat = started;
    var kinds = {};   // вид команды -> { n, ms, worst, at }
    var order = [];   // порядок появления: у объекта его нет

    function tell(level, msg) {
        if (host && host.log) host.log(level, msg);
    }
    function sec(ms) { return (ms / 1000).toFixed(1); }

    return {
        /** Отметка «дошли до сюда»: ставится ДО команды, чтобы назвать зависшую. */
        beat: function (i, n, kind) {
            var now = Date.now();
            if (now - beat < APPLY_BEAT_MS) return;
            beat = now;
            tell('INFO', 'apply: команда ' + i + ' из ' + n + ' (' + kind + '), прошло ' +
                 sec(now - started) + ' с');
        },
        add: function (kind, ms, at) {
            var k = kinds[kind];
            if (!k) { k = kinds[kind] = { n: 0, ms: 0, worst: 0, at: 0 }; order.push(kind); }
            k.n++;
            k.ms += ms;
            if (ms > k.worst) { k.worst = ms; k.at = at; }
            if (ms >= APPLY_SLOW_MS) {
                tell('WARN', 'apply: cmds[' + at + '] (' + kind + ') занял ' + sec(ms) + ' с');
            }
        },
        report: function (jobId, n, ok) {
            var total = Date.now() - started;
            var by = order.slice().sort(function (a, b) { return kinds[b].ms - kinds[a].ms; });
            var parts = [];
            for (var i = 0; i < by.length; i++) {
                var k = kinds[by[i]];
                parts.push(by[i] + ' ' + k.n + ' -- ' + sec(k.ms) + ' с' +
                           (k.worst >= APPLY_SLOW_MS ? ' (худшая ' + sec(k.worst) + ' с на cmds[' + k.at + '])' : ''));
            }
            tell(ok ? 'INFO' : 'ERROR', 'apply ' + jobId + ': ' + n + ' команд за ' + sec(total) + ' с' +
                 (ok ? '' : ' и ОТКАТ') + (parts.length ? '; ' + parts.join('; ') : ''));
        }
    };
}

/**
 * Ребро контура, крайнее вдоль названной мировой оси.
 * Номер ребра в Базисе зависит от ориентации панели и нигде не задан, поэтому
 * сторона называется направлением («z+»), а ребро ищется геометрически.
 */
function pickEdge(host, panel, side) {
    var axis = side.charAt(0);
    var sign = side.charAt(1);
    var slot = axis === 'x' ? 0 : axis === 'y' ? 1 : 2;
    var edges = host.contourEdges(panel);
    if (!edges || !edges.length) throw new Error('у панели нет контура');

    var best = null, bestV = 0, spread = 0, minV = 0, maxV = 0;
    for (var i = 0; i < edges.length; i++) {
        var v = edges[i].mid[slot];
        if (best === null) { best = edges[i]; bestV = v; minV = v; maxV = v; }
        if (v < minV) minV = v;
        if (v > maxV) maxV = v;
        if (sign === '-' ? v < bestV : v > bestV) { best = edges[i]; bestV = v; }
    }
    spread = maxV - minV;
    // Ось толщины: все середины рёбер лежат в одной плоскости, крайнего ребра нет.
    if (spread === 0) throw new Error('сторона «' + side + '» не различает рёбра контура');
    return best.i;
}

/**
 * Выполнить задачу. Возвращает результат, наружу не бросает: половина кухни
 * в модели хуже внятного кода возврата.
 */
function applyJob(job, host) {
    var stats = emptyStats();

    if (job.v !== PROTOCOL_VERSION) {
        return {
            v: PROTOCOL_VERSION, jobId: job.jobId, ok: false, duplicate: false,
            error: 'версия протокола запроса ' + job.v + ', агент говорит на ' + PROTOCOL_VERSION +
                   ' — перезапустите скрипт teril-agent в Базисе'
        };
    }

    var prof = profiler(host);

    // Идемпотентность: тот же jobId не собирает кухню дважды. Проверка идёт по
    // модели, а не только по памяти агента, — тогда она переживает перезапуск.
    // Мерится тоже: она читает свойство у КАЖДОГО объекта сцены и на чужой
    // большой модели успевает подвесить окно ещё до первой команды.
    var td = Date.now();
    var already = jobAlreadyApplied(host, job.jobId);
    prof.add('проверка дубля', Date.now() - td, -1);
    if (already) {
        return { v: PROTOCOL_VERSION, jobId: job.jobId, ok: true, duplicate: true, stats: stats };
    }

    var made = [];        // объекты в порядке создания — то, чем протокол ссылается
    var topCreated = [];  // созданное на верхнем уровне: на него вешается метка задачи
    var scopes = [];      // открытые блоки; покупной помнит своих детей до blockEnd
    /*
     * Группы, поставленные схемой. Держим их отдельным списком РАДИ ОТКАТА:
     * объекты MountScheme попадают в модель сразу и Action.Revert() их
     * не забирает -- "не звать Commit" тут не откат. Поэтому на ошибке
     * их сносим руками, и только потом откатываем остальное.
     */
    var mounted = [];
    var depth = 0;
    var cmds = job.cmds || [];

    host.begin();
    try {
        for (var i = 0; i < cmds.length; i++) {
            var cmd = cmds[i];
            prof.beat(i, cmds.length, cmd.c);
            var t0 = Date.now();
            try {
                runCmd(cmd, host, made, topCreated, depth, stats, scopes, mounted);
            } catch (e) {
                throw new Error('cmds[' + i + '] (' + cmd.c + '): ' + (e && e.message ? e.message : e));
            }
            prof.add(cmd.c, Date.now() - t0, i);
            if (cmd.c === 'blockBegin') depth++;
            if (cmd.c === 'blockEnd') depth--;
        }
        if (depth !== 0) throw new Error('не закрыто блоков: ' + depth);

        // Метка задачи и заказа — на объектах ВЕРХНЕГО уровня: по ним потом ищет
        // deleteTop, который по устройству глубже не ходит.
        var tp = Date.now();
        for (var k = 0; k < topCreated.length; k++) {
            host.prop(topCreated[k], 'jobId', job.jobId);
            if (job.orderId) host.prop(topCreated[k], 'orderId', job.orderId);
        }
        prof.add('метка заказа', Date.now() - tp, -1);

        // Commit меряется ОТДЕЛЬНО: он перестраивает и перерисовывает модель
        // целиком, и на большой сцене стоит больше всех команд вместе взятых.
        var tc = Date.now();
        host.commit();
        prof.add('commit', Date.now() - tc, -1);
        stats.commits = 1;
        prof.report(job.jobId, cmds.length, true);
    } catch (err) {
        // Отчёт пишется и здесь: неудачная сборка -- самая интересная,
        // а откат у Базиса и сам по себе бывает долгим.
        var tr = Date.now();
        // Схемы -- ДО отката: откат их не заберёт, и остались бы они в модели
        // крепежом без мебели. Своя ошибка здесь не должна отбирать откат
        // у всего остального, поэтому каждая снимается отдельно.
        for (var m = mounted.length - 1; m >= 0; m--) {
            try { host.remove(mounted[m]); } catch (e2) {}
        }
        host.revert();
        prof.add('revert', Date.now() - tr, -1);
        prof.report(job.jobId, cmds.length, false);
        return {
            v: PROTOCOL_VERSION, jobId: job.jobId, ok: false, duplicate: false,
            stats: stats, error: err && err.message ? err.message : String(err)
        };
    }

    return { v: PROTOCOL_VERSION, jobId: job.jobId, ok: true, duplicate: false, stats: stats };
}

function runCmd(cmd, host, made, topCreated, depth, stats, scopes, mounted) {
    var obj;
    switch (cmd.c) {
        case 'material':
            host.material(cmd.name, cmd.t);
            return;

        case 'panel':
            obj = host.panel(cmd.plane, cmd.a1, cmd.b1, cmd.a2, cmd.b2, cmd.pos, cmd.name);
            made.push(obj);
            born(obj, topCreated, depth, scopes);
            stats.panels++;
            return;

        case 'butt':
            var p = need(made, cmd.panel);
            host.setButt(p, pickEdge(host, p, cmd.side), cmd.material, cmd.t, cmd.w, cmd.clip !== false);
            stats.butts++;
            return;

        case 'scheme':
            host.schemeDef(cmd.id, cmd.enc);
            return;

        case 'mountScheme':
            // Крепёж внутри группы считает Базис, поэтому в stats идёт СТЫК,
            // а не штуки: числа штук у нас нет и взяться ему неоткуда.
            obj = host.mountScheme(cmd.scheme, need(made, cmd.panels[0]), need(made, cmd.panels[1]),
                                   cmd.position, cmd.at);
            // Ссылка нужна: на группу едет метка ведра, как на объёмы.
            // Порядок push обязан совпасть с клиентским createsRef.
            made.push(obj);
            born(obj, topCreated, depth, scopes);
            mounted.push(obj);
            stats.schemes++;
            return;

        case 'blockBegin':
            // ПОКУПНОЕ ИЗДЕЛИЕ — это Сборка, а не Блок: в "Расчёте стоимости"
            // поштучно считается только TFurnAsm, содержимое TFurnBlock уходит
            // в материалы и раскрой. BeginAssembly в API нет вовсе, поэтому
            // объекты создаются рядом и переподчиняются в сборку на blockEnd
            // (Owner = asm), пока она стоит в начале координат: мировые
            // координаты детей от переподчинения не съезжают.
            if (cmd.purchased) {
                obj = host.assembly(cmd.name);
                made.push(obj);
                born(obj, topCreated, depth, scopes);
                scopes.push({ obj: obj, kids: [] });
                stats.assemblies++;
            } else {
                obj = host.blockBegin(cmd.name);
                // Ссылка нужна и обычному блоку: на нём висят атрибуты узла
                // спеки. Порядок push обязан совпасть с клиентским createsRef --
                // ссылка это индекс создания, а не идентификатор.
                made.push(obj);
                born(obj, topCreated, depth, scopes);
                scopes.push(null);
            }
            return;

        case 'blockEnd':
            if (!scopes.length) throw new Error('blockEnd без blockBegin');
            var scope = scopes.pop();
            if (scope) {
                for (var c = 0; c < scope.kids.length; c++) host.adopt(scope.kids[c], scope.obj);
            } else {
                host.blockEnd();
            }
            return;

        case 'assembly':
            obj = host.assembly(cmd.name, cmd.at);
            made.push(obj);
            born(obj, topCreated, depth, scopes);
            for (var a = 0; a < (cmd.adopt || []).length; a++) host.adopt(need(made, cmd.adopt[a]), obj);
            stats.assemblies++;
            return;

        case 'extrude':
            obj = host.extrude(cmd.name, cmd.contour.d, cmd.len, cmd.material, cmd.materialWidth,
                               cmd.orientZ, cmd.orientY, cmd.at);
            made.push(obj);
            born(obj, topCreated, depth, scopes);
            stats.extrusions++;
            return;

        case 'prop':
            host.prop(need(made, cmd.ref), cmd.key, cmd.value);
            return;

        case 'deleteTop':
            stats.deleted += deleteTop(host, cmd.match);
            return;

        default:
            throw new Error('неизвестная команда');
    }
}

/**
 * Объект только что создан: пометить его для маркировки заказом и, если открыт
 * ПОКУПНОЙ блок, запомнить как будущего ребёнка его сборки. У обычного блока
 * запоминать нечего: BeginBlock подчиняет созданное сам.
 */
function born(obj, topCreated, depth, scopes) {
    if (depth === 0) topCreated.push(obj);
    var scope = scopes.length ? scopes[scopes.length - 1] : null;
    if (scope) scope.kids.push(obj);
}

function need(made, ref) {
    var o = made[ref];
    if (o === undefined) throw new Error('ссылка на несозданный объект #' + ref);
    return o;
}

/**
 * Удаление ТОЛЬКО верхнего уровня. Дети блоков в список не попадают в принципе:
 * DeleteObject(block) уносит их с собой, а повторное удаление ребёнка — краш движка.
 */
function deleteTop(host, match) {
    var top = host.topObjects();
    var doomed = [];
    for (var i = 0; i < top.length; i++) {
        if (matches(host, top[i], match)) doomed.push(top[i]);
    }
    for (var k = doomed.length - 1; k >= 0; k--) host.remove(doomed[k]);
    return doomed.length;
}

function matches(host, obj, match) {
    if (!match) return false;
    if (match.name !== undefined && host.objName(obj) !== match.name) return false;
    if (match.prop !== undefined && String(host.objProp(obj, match.prop.key)) !== String(match.prop.value)) return false;
    return match.name !== undefined || match.prop !== undefined;
}

function jobAlreadyApplied(host, jobId) {
    var top = host.topObjects();
    for (var i = 0; i < top.length; i++) {
        if (String(host.objProp(top[i], 'jobId')) === String(jobId)) return true;
    }
    return false;
}

// Проверки «есть ли такой материал в базе» здесь НЕТ намеренно. Она была и врала:
// ActiveMaterial.Make() молча заводит материал, если такого имени нет, и чтение
// имени обратно подтверждает выдуманное имя ровно так же, как настоящее.
// Список имён ведётся в репозитории (src/bazis/naming.ts), базу материалов — человек.

/** Единая точка входа: метод ? ответ. Транспорт снаружи. */
function handle(job, host) {
    if (job.method === 'ping') {
        return { v: PROTOCOL_VERSION, jobId: job.jobId, ok: true, duplicate: false,
                 data: { protocol: PROTOCOL_VERSION, api: host.apiVersion() } };
    }
    if (job.method === 'model') {
        return { v: PROTOCOL_VERSION, jobId: job.jobId, ok: true, duplicate: false, data: host.serialize() };
    }
    if (job.method === 'apply') {
        return applyJob(job, host);
    }
    // Строка разговора с проектировщиком. Едет тем же каналом, что и сборка:
    // у скрипта один цикл опроса, один адрес и одна авторизация. Модель Базиса
    // при этом не трогается вовсе -- команд у такой задачи нет.
    if (job.method === 'ui') {
        if (host.ui) host.ui(job.text || '', job.kind || 'log');
        return { v: PROTOCOL_VERSION, jobId: job.jobId, ok: true, duplicate: false };
    }
    return { v: PROTOCOL_VERSION, jobId: job.jobId, ok: false, duplicate: false,
             error: 'неизвестный метод: ' + job.method };
}

/* ?? Хост: тонкие обёртки над глобалями Базиса ?????????????????????????????? */
//
// Обёртки, а не проброс самих функций: нативные методы движка чувствительны к
// тому, на чём их зовут, поэтому вызовы остаются глобальными.

function bazisHost() {
    return {
        apiVersion: function () {
            try { return system.apiVersion; } catch (e) { return 0; }
        },

        begin: function () { Action.Continue(); },
        commit: function () { Action.Commit(); },
        revert: function () { Action.Revert(); },

        material: function (name, t) { ActiveMaterial.Make(name, t); },

        panel: function (plane, a1, b1, a2, b2, pos, name) {
            var p = plane === 'vert' ? AddVertPanel(a1, b1, a2, b2, pos)
                  : plane === 'horiz' ? AddHorizPanel(a1, b1, a2, b2, pos)
                  : AddFrontPanel(a1, b1, a2, b2, pos);
            p.Name = name;
            return p;
        },

        // Мировые середины рёбер контура: контур лежит в локальной плоскости
        // панели (z = 0..Thickness), поэтому середину поднимаем на полтолщины.
        contourEdges: function (p) {
            var out = [], n = p.Contour.Count;
            for (var i = 0; i < n; i++) {
                var L = p.Contour.Objects[i].AsLine();
                var mx = (L.Pos1.x + L.Pos2.x) / 2, my = (L.Pos1.y + L.Pos2.y) / 2;
                var M = p.ToGlobal(NewVector(mx, my, p.Thickness / 2));
                out.push({ i: i, mid: [M.x, M.y, M.z] });
            }
            return out;
        },

        // Butts.Add(), а не AddButt: последний требует объект материала, который
        // без UI с конкретным именем не задать.
        setButt: function (panel, elem, material, t, w, clip) {
            var b = panel.Butts.Add();
            b.ElemIndex = elem;
            b.Material = material;
            b.Thickness = t;
            b.Width = w;
            b.ClipPanel = clip;
            return b;
        },

        schemes: {},
        /*
         * Схема, приехавшая строкой, разбирается ОДИН раз на задачу и живёт
         * в этом значении: `DecodeFromString` на каждый стык стоил бы полсотни
         * разборов чужого формата на кухню.
         *
         * Значение берётся у страницы свойств, и только у неё: у объекта
         * из `OpenFurniture()` MountScheme возвращает undefined и оставляет
         * в модели бестелесную «линию стыка». DatumMode после разбора обязан
         * стать 7 (Scheme) -- иначе в строке не схема, и молчать об этом нельзя.
         */
        schemeDef: function (id, enc) {
            var v = Action.Properties.NewFurnitureValue();
            v.DecodeFromString(enc);
            if (v.DatumMode !== 7) {
                throw new Error('строка схемы «' + id + '» разобралась не в схему (DatumMode ' +
                                v.DatumMode + ') -- выберите схему заново в настройках места');
            }
            this.schemes[id] = v;
        },

        /*
         * СТЫК, ПОСТАВЛЕННЫЙ СХЕМОЙ ЦЕХА: раскладку по стыку считает сам Базис
         * -- ровно так, как это делает оператор руками. Пустой результат --
         * ошибка, а не пустая работа: молча не поставить крепёж хуже, чем упасть.
         */
        mountScheme: function (id, p1, p2, position, at) {
            var v = this.schemes[id];
            if (!v) throw new Error('схема «' + id + '» не приехала перед стыком');
            var grp = v.MountScheme(p1, p2, position, NewVector(at[0], at[1], at[2]));
            if (!grp) throw new Error('схема не встала: MountScheme вернул пусто');
            return grp;
        },

        blockBegin: function (name) { return BeginBlock(name); },
        blockEnd: function () { EndBlock(); },

        assembly: function (name, at) {
            var a = AddAssembly(name);
            if (at) a.Translate(NewVector(at[0], at[1], at[2]));
            return a;
        },
        adopt: function (child, parent) { child.Owner = parent; },

        extrude: function (name, d, len, material, materialWidth, oz, oy, at) {
            ActiveMaterial.Make(material, materialWidth || d);
            var e = AddExtrusion(name);
            // Сечение задаётся СРАЗУ, до контура: иначе погонный учёт не включится,
            // а на закоммиченной экструзии его уже не поменять.
            if (materialWidth) e.MaterialWidth = materialWidth;
            e.MaterialName = material;
            e.Contour.AddCircle(0, 0, d / 2);
            e.Orient(NewVector(oz[0], oz[1], oz[2]), NewVector(oy[0], oy[1], oy[2]));
            e.Thickness = len;
            e.Translate(NewVector(at[0], at[1], at[2]));
            try { e.Build(); } catch (err) {} // без явной перестройки тело иногда вырождается
            return e;
        },

        prop: function (obj, key, value) { obj.UserProperty[key] = value; },

        topObjects: function () {
            var list = (typeof Model.AsList === 'function') ? Model.AsList() : Model;
            var out = [];
            for (var i = 0; i < list.Count; i++) out.push(list.Objects[i]);
            return out;
        },
        objName: function (obj) { try { return obj.Name; } catch (e) { return null; } },
        objProp: function (obj, key) { try { return obj.UserProperty[key]; } catch (e) { return undefined; } },
        remove: function (obj) { DeleteObject(obj); },

        serialize: function () { return serializeModel(); }
    };
}

/**
 * Дамп модели для обратного чтения. Отдаёт ровно то, из чего src/bazis/read.ts
 * собирает список панелей: мировой габарит, материал, толщину, маркировку и
 * кромки с мировой серединой их ребра (номер ребра сам по себе ничего не значит).
 */
function serializeModel() {
    var list = (typeof Model.AsList === 'function') ? Model.AsList() : Model;
    var out = [];
    for (var i = 0; i < list.Count; i++) collect(list.Objects[i], out, 0, null);
    return { objects: out };
}

/** Десятые доли миллиметра: присадка стоит на целых, а чашка узкой рамы -- на половине. */
function r1(v) { return Math.round(v * 10) / 10; }

function collect(obj, out, depth, parent) {
    if (!obj || depth > 8) return;
    // Дамп ПЛОСКИЙ: дети идут в тот же массив следом за родителем, и связи
    // между ними в записи нет. Без depth/parent не отличить объект верхнего
    // уровня от вложенного, а блок узла -- от его же панелей.
    var rec = { name: null, type: 'unknown', props: {}, depth: depth,
                parent: parent === undefined ? null : parent };
    try { rec.name = obj.Name; } catch (e) {}
    try { rec.uid = obj.UID; } catch (e) {}
    try {
        var n = obj.UserPropCount;
        for (var u = 0; u < n; u++) rec.props[obj.UserPropertyName[u]] = obj.UserProperty[u];
    } catch (e) {}
    try {
        var mn = obj.GabMin, mx = obj.GabMax;
        if (mn && mx && mn.x !== undefined) {
            rec.min = [Math.round(mn.x), Math.round(mn.y), Math.round(mn.z)];
            rec.max = [Math.round(mx.x), Math.round(mx.y), Math.round(mx.z)];
        }
    } catch (e) {}

    // Присадка: единственный объект, у которого есть отверстия. Панель их
    // не отдаёт вовсе -- Panel3D.Holes не существует, а panel.Cuts пуст даже
    // после DrillHoles. Координаты мировые (ObjectToGlobal для точки,
    // NObjectToGlobal для направления -- оно без сдвига): матрицу присадки
    // на чтение не отдаёт ни одно свойство, и восстановить её иначе нельзя.
    try {
        if (obj.Holes && obj.Holes.Count) {
            rec.type = 'fastener';
            rec.holes = [];
            for (var hi = 0; hi < obj.Holes.Count; hi++) {
                var h = obj.Holes[hi];
                var hp = obj.ObjectToGlobal(h.Position);
                var hd = obj.NObjectToGlobal(h.Direction);
                rec.holes.push({ d: h.Diameter, depth: h.Depth,
                                 at: [r1(hp.x), r1(hp.y), r1(hp.z)],
                                 dir: [r1(hd.x), r1(hd.y), r1(hd.z)] });
            }
            out.push(rec);
            return;
        }
    } catch (e) {}

    if (obj.List) {
        rec.type = 'group';
        out.push(rec);
        var l = obj.AsList();
        for (var c = 0; c < l.Count; c++) collect(l.Objects[c], out, depth + 1, rec.uid === undefined ? null : rec.uid);
        return;
    }

    try {
        var p = obj.AsPanel;
        if (p && p.ContourWidth !== undefined) {
            rec.type = 'panel';
            rec.t = p.Thickness;
            rec.material = p.MaterialName;
            rec.butts = [];
            var cnt = p.Butts.Count, arr = p.Butts.Butts;
            for (var b = 0; b < cnt; b++) {
                var e = arr[b];
                rec.butts.push({ elem: e.ElemIndex, material: e.Material, t: e.Thickness, w: e.Width, mid: edgeMid(p, e.ElemIndex) });
            }
        }
    } catch (e) {}

    out.push(rec);
}

function edgeMid(p, elem) {
    try {
        var L = p.Contour.Objects[elem].AsLine();
        var mx = (L.Pos1.x + L.Pos2.x) / 2, my = (L.Pos1.y + L.Pos2.y) / 2;
        var M = p.ToGlobal(NewVector(mx, my, p.Thickness / 2));
        return [Math.round(M.x), Math.round(M.y), Math.round(M.z)];
    } catch (e) {
        return null;
    }
}

